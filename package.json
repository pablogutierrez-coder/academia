{
  "name": "siga-elite",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @siga/api --filter @siga/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @siga/database exec prisma generate",
    "db:migrate": "pnpm --filter @siga/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @siga/database exec prisma db seed",
    "firebase:emulators": "firebase emulators:start --only firestore --project demo-siga-elite",
    "firebase:emulators:export": "firebase emulators:export ./firebase-data",
    "firebase:deploy": "firebase deploy --only firestore",
    "firebase:migrate:dry": "pnpm --filter @siga/api firebase:migrate:dry",
    "firebase:migrate": "pnpm --filter @siga/api firebase:migrate",
    "firebase:seed:dry": "pnpm --filter @siga/api firebase:seed:dry",
    "firebase:seed": "pnpm --filter @siga/api firebase:seed",
    "firebase:deploy:rules": "pnpm --filter @siga/api firebase:deploy:rules"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "eslint": "9.32.0",
    "firebase-tools": "15.24.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.38.0"
  }
}
